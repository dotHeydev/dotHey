{
  "name": "GitHub Copilot",
  "docs": "https://docs.github.com/en/copilot/concepts/agents/about-agent-skills",
  "detect": [
    ".github/copilot-instructions.md",
    ".github/instructions/",
    ".github/agents/",
    ".github/skills/",
    ".vscode/mcp.json"
  ],
  "instructions": null,
  "skills": ".agents/skills/",
  "agents": {
    "dir": ".github/agents/",
    "file": "{name}.agent.md"
  },
  "context": {
    "instructions": [
      ".github/copilot-instructions.md"
    ],
    "rule": [
      ".github/instructions/"
    ],
    "skill": [
      ".github/skills/"
    ],
    "mcp": [
      ".vscode/mcp.json"
    ]
  }
}
